{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eclipse-os",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
